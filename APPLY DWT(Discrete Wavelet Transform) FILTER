import pywt
import shutil

# ------------------ Step 1: Upload the Input Image ------------------
print("Upload the speckled ultrasound image:")
uploaded = files.upload()
img_path = list(uploaded.keys())[0]
img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
img = cv2.resize(img, (512, 512))

# ------------------ Step 2: DWT Filtering ------------------
def dwt_filter(img, wavelet='db1'):
    """Applies DWT, zeros detail coefficients, and reconstructs image for denoising."""
    img = np.float32(img) / 255.0
    coeffs2 = pywt.dwt2(img, wavelet)
    cA, (cH, cV, cD) = coeffs2
    # Zero the detail coefficients
    cH.fill(0)
    cV.fill(0)
    cD.fill(0)
    img_denoised = pywt.idwt2((cA, (cH, cV, cD)), wavelet)
    return np.uint8(np.clip(img_denoised * 255, 0, 255))

dwt_output = dwt_filter(img)

# ------------------ Step 3: Edge Detectors ------------------
edges = {}

edges['Canny'] = cv2.Canny(dwt_output, 100, 200)

blur = cv2.GaussianBlur(dwt_output, (3, 3), 0)
edges['ISEF'] = cv2.Laplacian(blur, cv2.CV_8U)

marr = cv2.Laplacian(cv2.GaussianBlur(dwt_output, (5, 5), 1.5), cv2.CV_64F)
edges['Marr-Hildreth'] = np.uint8(np.absolute(marr))

kirsch_kernels = [
    np.array([[5,5,5],[-3,0,-3],[-3,-3,-3]]), np.array([[-3,5,5],[-3,0,5],[-3,-3,-3]]),
    np.array([[-3,-3,5],[-3,0,5],[-3,-3,5]]), np.array([[-3,-3,-3],[-3,0,5],[-3,5,5]]),
    np.array([[-3,-3,-3],[-3,0,-3],[5,5,5]]), np.array([[-3,-3,-3],[5,0,-3],[5,5,-3]]),
    np.array([[5,-3,-3],[5,0,-3],[5,-3,-3]]), np.array([[5,5,-3],[5,0,-3],[-3,-3,-3]])
]
kirsch = np.max([cv2.filter2D(dwt_output, -1, k) for k in kirsch_kernels], axis=0)
edges['Kirsch'] = kirsch

scharr_x = cv2.Scharr(dwt_output, cv2.CV_64F, 1, 0)
scharr_y = cv2.Scharr(dwt_output, cv2.CV_64F, 0, 1)
edges['Scharr'] = cv2.convertScaleAbs(cv2.magnitude(scharr_x, scharr_y))

# ------------------ Step 4: Display & Save Images ------------------
output_folder = "dwt_edges"
os.makedirs(output_folder, exist_ok=True)

plt.figure(figsize=(12, 4))
for idx, (name, edge_img) in enumerate(edges.items()):
    plt.subplot(1, 5, idx + 1)
    plt.imshow(edge_img, cmap='gray')
    plt.title(name, fontsize=10)
    plt.axis('off')
    save_path = f"{output_folder}/{name}_edge.png"
    cv2.imwrite(save_path, edge_img)

plt.tight_layout()
plt.show()

# Save DWT Filtered Output
cv2.imwrite(f"{output_folder}/DWT_filtered.png", dwt_output)

# ------------------ Step 5: Zip and Download ------------------
shutil.make_archive("dwt_edge_outputs", 'zip', output_folder)
files.download("dwt_edge_outputs.zip")
