# ---------------------- Edge Detection Script with 5 Detectors ----------------------

import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

# ----------------------------- Utility Functions -----------------------------

# Binarize image (for future evaluation if needed)
def binarize(img):
    return (img > 0).astype(np.uint8)

# Marr-Hildreth edge detection using Gaussian + Laplacian
def marr_hildreth_edge(img):
    blurred = cv2.GaussianBlur(img, (5, 5), 0)
    laplacian = cv2.Laplacian(blurred, cv2.CV_64F)
    return cv2.convertScaleAbs(laplacian)

# Scharr edge detection based on gradient magnitude
def scharr_edge(img):
    gx = cv2.Scharr(img, cv2.CV_64F, 1, 0)
    gy = cv2.Scharr(img, cv2.CV_64F, 0, 1)
    magnitude = cv2.magnitude(gx, gy)
    return cv2.convertScaleAbs(magnitude)

# Kirsch edge detection using eight compass kernels
def kirsch_edge(img):
    kernels = [
        np.array([[ 5,  5,  5], [-3,  0, -3], [-3, -3, -3]]),
        np.array([[-3,  5,  5], [-3,  0,  5], [-3, -3, -3]]),
        np.array([[-3, -3,  5], [-3,  0,  5], [-3, -3,  5]]),
        np.array([[-3, -3, -3], [-3,  0,  5], [-3,  5,  5]]),
        np.array([[-3, -3, -3], [-3,  0, -3], [ 5,  5,  5]]),
        np.array([[-3, -3, -3], [ 5,  0, -3], [ 5,  5, -3]]),
        np.array([[ 5, -3, -3], [ 5,  0, -3], [ 5, -3, -3]]),
        np.array([[ 5,  5, -3], [ 5,  0, -3], [-3, -3, -3]])
    ]
    edges = [cv2.filter2D(img, -1, k) for k in kernels]
    return np.max(np.stack(edges), axis=0)

# Canny edge detection with default thresholds
def canny_edge(img, low=100, high=200):
    return cv2.Canny(img, low, high)

# Simulated ISEF: Bilateral filter (for smoothing) + Canny
def isef_edge(img):
    smoothed = cv2.bilateralFilter(img, 9, 75, 75)
    return cv2.Canny(smoothed, 50, 150)

# ----------------------------- Load Image -----------------------------
print("Upload a grayscale medical image:")
uploaded = files.upload()
img_path = next(iter(uploaded))
gray = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)

# ----------------------------- Apply Edge Detection Methods -----------------------------
edge_maps = {
    "Marr-Hildreth": marr_hildreth_edge(gray),
    "Scharr": scharr_edge(gray),
    "Canny": canny_edge(gray),
    "Kirsch": kirsch_edge(gray),
    "ISEF": isef_edge(gray)
}

# ----------------------------- Save Edge Images -----------------------------
for name, img in edge_maps.items():
    file_name = f"{name.replace(' ', '_')}_edges.png"
    cv2.imwrite(file_name, img)
    print(f"Download {name} result:")
    files.download(file_name)
# ----------------------------- Visualization with Reduced Horizontal Spacing -----------------------------
plt.figure(figsize=(12, 6))  # Adjust figure size for compact layout

# Arrange 6 images: 1 in the top-left corner (Original) and the others in a 2x3 grid
titles = ["Original"] + list(edge_maps.keys())[:5]
images = [gray] + list(edge_maps.values())[:5]

for i in range(6):
    plt.subplot(2, 3, i + 1)  # 2 rows, 3 columns grid for plotting images
    plt.imshow(images[i], cmap='gray')
    plt.title(titles[i], fontsize=10)  # Set title for each subplot
    plt.axis('off')  # Hide axes for cleaner output

# Reduce space between columns and rows
plt.subplots_adjust(wspace=0.0000000000000000006, hspace=0.1)  # Smaller wspace = less horizontal space and hspace = vertical space
plt.show()  # Display the final plot
