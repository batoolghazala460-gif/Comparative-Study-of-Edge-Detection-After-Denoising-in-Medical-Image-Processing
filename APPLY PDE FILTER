import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files
import os
import shutil

# ------------------ Upload Image ------------------
print("Upload the speckled ultrasound image:")
uploaded = files.upload()
img_path = next(iter(uploaded))
img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
img = cv2.resize(img, (512, 512))

# ------------------ PDE Filtering ------------------
def anisotropic_diffusion(img, num_iter=15, kappa=30, gamma=0.1, option=1):
    img = img.astype(np.float32)
    for _ in range(num_iter):
        img_north = np.roll(img, -1, axis=0)
        img_south = np.roll(img, 1, axis=0)
        img_east = np.roll(img, -1, axis=1)
        img_west = np.roll(img, 1, axis=1)

        deltaN = img_north - img
        deltaS = img_south - img
        deltaE = img_east - img
        deltaW = img_west - img

        if option == 1:
            cN = np.exp(-(deltaN/kappa)**2)
            cS = np.exp(-(deltaS/kappa)**2)
            cE = np.exp(-(deltaE/kappa)**2)
            cW = np.exp(-(deltaW/kappa)**2)
        else:
            cN = 1.0 / (1.0 + (deltaN/kappa)**2)
            cS = 1.0 / (1.0 + (deltaS/kappa)**2)
            cE = 1.0 / (1.0 + (deltaE/kappa)**2)
            cW = 1.0 / (1.0 + (deltaW/kappa)**2)

        img += gamma * (cN*deltaN + cS*deltaS + cE*deltaE + cW*deltaW)
    return np.uint8(np.clip(img, 0, 255))

pde_output = anisotropic_diffusion(img)

# ------------------ Edge Detection ------------------
edges = {}

edges['Canny'] = cv2.Canny(pde_output, 100, 200)

blur = cv2.GaussianBlur(pde_output, (3, 3), 0)
edges['ISEF'] = cv2.Laplacian(blur, cv2.CV_8U)

marr = cv2.Laplacian(cv2.GaussianBlur(pde_output, (5, 5), 1.5), cv2.CV_64F)
edges['Marr-Hildreth'] = np.uint8(np.absolute(marr))

kirsch_kernels = [
    np.array([[5,5,5],[-3,0,-3],[-3,-3,-3]]), np.array([[-3,5,5],[-3,0,5],[-3,-3,-3]]),
    np.array([[-3,-3,5],[-3,0,5],[-3,-3,5]]), np.array([[-3,-3,-3],[-3,0,5],[-3,5,5]]),
    np.array([[-3,-3,-3],[-3,0,-3],[5,5,5]]), np.array([[-3,-3,-3],[5,0,-3],[5,5,-3]]),
    np.array([[5,-3,-3],[5,0,-3],[5,-3,-3]]), np.array([[5,5,-3],[5,0,-3],[-3,-3,-3]])
]
kirsch = np.max([cv2.filter2D(pde_output, -1, k) for k in kirsch_kernels], axis=0)
edges['Kirsch'] = kirsch

scharr_x = cv2.Scharr(pde_output, cv2.CV_64F, 1, 0)
scharr_y = cv2.Scharr(pde_output, cv2.CV_64F, 0, 1)
edges['Scharr'] = cv2.convertScaleAbs(cv2.magnitude(scharr_x, scharr_y))

# ------------------ Display & Save ------------------
output_folder = "pde_edges"
os.makedirs(output_folder, exist_ok=True)

plt.figure(figsize=(12, 4))
for idx, (name, edge_img) in enumerate(edges.items()):
    plt.subplot(1, 5, idx + 1)
    plt.imshow(edge_img, cmap='gray')
    plt.title(name, fontsize=10)
    plt.axis('off')
    save_path = f"{output_folder}/{name}_edge.png"
    cv2.imwrite(save_path, edge_img)

plt.tight_layout()
plt.show()

# Save PDE Output
cv2.imwrite(f"{output_folder}/PDE_filtered.png", pde_output)

# Zip for download
shutil.make_archive("pde_edge_outputs", 'zip', output_folder)
files.download("pde_edge_outputs.zip")
