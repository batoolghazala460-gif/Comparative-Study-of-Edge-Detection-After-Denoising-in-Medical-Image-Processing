import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files
from scipy.ndimage import gaussian_filter, sobel
import os

# ------------------ Step 1: Upload the Input Image ------------------
print("Upload the speckled ultrasound image:")
uploaded = files.upload()
img_path = list(uploaded.keys())[0]
img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
img = cv2.resize(img, (512, 512))

# ------------------ Step 2: OSRAD Filter (Full Pipeline) ------------------

def osrad_filter(image, num_iter=10, delta_t=0.15):
    img = image.astype(np.float32)
    for _ in range(num_iter):
        Ix = sobel(img, axis=1)
        Iy = sobel(img, axis=0)
        grad_mag_sq = Ix**2 + Iy**2

        J11 = gaussian_filter(Ix * Ix, sigma=1)
        J22 = gaussian_filter(Iy * Iy, sigma=1)
        J12 = gaussian_filter(Ix * Iy, sigma=1)

        trace = J11 + J22
        det = J11 * J22 - J12 ** 2
        sqrt_term = np.sqrt(np.maximum(trace**2 - 4*det, 0))
        lambda1 = 0.5 * (trace + sqrt_term)
        lambda2 = 0.5 * (trace - sqrt_term)

        vx = np.where(J12 != 0, lambda1 - J11, 1.0)
        vy = np.where(J12 != 0, J12, 0.0)
        norm = np.sqrt(vx**2 + vy**2 + 1e-12)
        vx /= norm
        vy /= norm

        g = np.exp(-grad_mag_sq / (np.mean(grad_mag_sq) + 1e-6))

        D = np.zeros((img.shape[0], img.shape[1], 2, 2))
        for i in range(img.shape[0]):
            for j in range(img.shape[1]):
                v = np.array([[vx[i,j]], [vy[i,j]]])
                D[i,j] = g[i,j] * (v @ v.T) + 0.001 * np.eye(2)

        div = np.zeros_like(img)
        for i in range(1, img.shape[0]-1):
            for j in range(1, img.shape[1]-1):
                dIx = (img[i, j+1] - img[i, j-1]) * 0.5
                dIy = (img[i+1, j] - img[i-1, j]) * 0.5
                J = np.array([[dIx], [dIy]])
                flux = D[i,j] @ J
                div_x = (flux[0,0] - D[i-1,j][0,0]*dIx - D[i-1,j][0,1]*dIy)
                div_y = (flux[1,0] - D[i,j-1][1,0]*dIx - D[i,j-1][1,1]*dIy)
                div[i,j] = div_x + div_y

        img = img + delta_t * div
    return np.clip(img, 0, 255).astype(np.uint8)

osrad_output = osrad_filter(img)

# ------------------ Step 3: Edge Detectors ------------------

edges = {}

edges['Canny'] = cv2.Canny(osrad_output, 100, 200)

blur = cv2.GaussianBlur(osrad_output, (3,3), 0)
edges['ISEF'] = cv2.Laplacian(blur, cv2.CV_8U)

marr = cv2.Laplacian(cv2.GaussianBlur(osrad_output, (5,5), 1.5), cv2.CV_64F)
edges['Marr-Hildreth'] = np.uint8(np.absolute(marr))

kirsch_kernels = [
    np.array([[5,5,5],[-3,0,-3],[-3,-3,-3]]), np.array([[-3,5,5],[-3,0,5],[-3,-3,-3]]),
    np.array([[-3,-3,5],[-3,0,5],[-3,-3,5]]), np.array([[-3,-3,-3],[-3,0,5],[-3,5,5]]),
    np.array([[-3,-3,-3],[-3,0,-3],[5,5,5]]), np.array([[-3,-3,-3],[5,0,-3],[5,5,-3]]),
    np.array([[5,-3,-3],[5,0,-3],[5,-3,-3]]), np.array([[5,5,-3],[5,0,-3],[-3,-3,-3]])
]

kirsch = np.max([cv2.filter2D(osrad_output, -1, k) for k in kirsch_kernels], axis=0)
edges['Kirsch'] = kirsch

scharr_x = cv2.Scharr(osrad_output, cv2.CV_64F, 1, 0)
scharr_y = cv2.Scharr(osrad_output, cv2.CV_64F, 0, 1)
edges['Scharr'] = cv2.convertScaleAbs(cv2.magnitude(scharr_x, scharr_y))

# ------------------ Step 4: Display & Save Images ------------------

output_folder = "osrad_edges"
os.makedirs(output_folder, exist_ok=True)

plt.figure(figsize=(12, 4))
for idx, (name, edge_img) in enumerate(edges.items()):
    plt.subplot(1, 5, idx + 1)
    plt.imshow(edge_img, cmap='gray')
    plt.title(name, fontsize=10)
    plt.axis('off')
    save_path = f"{output_folder}/{name}_edge.png"
    cv2.imwrite(save_path, edge_img)

plt.tight_layout()
plt.show()

# Save OSRAD Output
cv2.imwrite(f"{output_folder}/OSRAD_filtered.png", osrad_output)

# Zip and download all images
import shutil
shutil.make_archive("osrad_edge_outputs", 'zip', output_folder)
files.download("osrad_edge_outputs.zip")
